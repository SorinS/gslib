let JWE_EC384 = """{"kty":"EC","kid":"peregrin.took@tuckborough.example","use":"enc","crv":"P-384","x":"YU4rRUzdmVqmRtWOs2OpDE_T5fsNIodcG8G5FWPrTPMyxpzsSOGaQLpe2FpxBmu2","y":"A8-yxCHxkfBz3hKZfI1jUYMjUhsEveZ9THuwFjH2sCNdtksRJU7D5-SkgaFL1ETP","d":"iTx2pk7wW-GqJkHcEkFQb2EFyYcO7RugmaW3mRrQVAOUiPommT0IdnYK2xDlZh-j"}""";
let JWE_EC256 = """{"kty":"EC","kid":"meriadoc.brandybuck@buckland.example","use":"enc","crv":"P-256","x":"Ze2loSV3wrroKUN_4zhwGhCqo3Xhu1td4QjeQ5wIVR0","y":"HlLtdXARY_f55A3fnzQbPcm6hgr34Mp8p-nuzQCE0Zw","d":"r_kHyZ-a06rmxM3yESK84r1otSg-aQcVStkRhA-iCM8"}""";
let JWE_X25519 = """{"kty":"OKP","kid":"Bob","use":"enc","crv":"X25519","x":"3p7bfXt9wbTTW2HC7OQ1Nz-DQ8hbeGdNrfx-FG-IK08","d":"XasIfmJKikt54X-Lg4AO5m87sSkmGLb9HC-LJ_-I4Os"}""";

var KEYS: jwk::Key[>..] = [];

let MAX_RECIPIENTS: i64 = 4;
let MAX_INFLATE:    i64 = 1 << 20;
let P2C:            i64 = 1000; // were PBES2 ever reached: the least count

export fn fuzz_one(data: const u8[:]) -> i32 {
    var m = jwe::Message { .. };
    let e = jwe::parse(m, data);
    if e != jwx::OK { return 0; }
    let _ = jwe::aad_of(m);
    let _ = jwe::header_string(m, "typ");
    let _ = jwe::header_string(m, "cty");
    for i in ::min(m.recipients.len, MAX_RECIPIENTS) {
        let alg = m.recipients[i].header.alg;
        if jwa::is_pbes2(alg) { continue; }
        let _ = jwa::name(alg);
        let _ = jwa::name(m.recipients[i].header.enc);
        // One key per recipient: the one its kid names, else the first that
        // fits (RSA and EC private-key operations are what make this slow).
        var pick = -1;
        for j in KEYS.len {
            if jwk::fits(KEYS[j], alg) {
                if pick < 0 { pick = j; }
                if KEYS[j].kid[..] == m.recipients[i].header.kid[..] { pick = j; break; }
            }
        }
        if pick >= 0 { let _ = jwe::decrypt_recipient(m, i, alg, KEYS[pick], P2C, MAX_INFLATE, P2C); }
    }
    if m.recipients.len <= MAX_RECIPIENTS {
        let _ = jwe::decrypt(data, jwa::A128KW, KEYS[1], P2C, MAX_INFLATE, P2C);
        let _ = jwe::decrypt(data, jwa::DIRECT, KEYS[0], P2C, MAX_INFLATE, P2C);
        // The symmetric keys only: the per-recipient loop above did the rest.
        let _ = jwe::decrypt_set(data, KEYS[..3], false, P2C, MAX_INFLATE, P2C);
    }
    return 0;
}

fn add(text: const u8[:]) {
    let k, e = jwk::parse(text);
    if e != jwx::OK { abort(str("fuzz key: ", jwx::error_text(e))); }
    KEYS.push(k);
}

fn main() {
    add(JWE_DIR);
    add(JWE_KW);
    add(JWE_GCMKW);
    add(JWE_RSA15);
    add(JWE_OAEP);
    add(JWE_EC384);
    add(JWE_EC256);
    add(JWE_X25519);
}
