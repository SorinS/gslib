posix i64 chown(path: const u8[:], uid: i64, gid: i64)
posix i64 lchown(path: const u8[:], uid: i64, gid: i64)
all   i64 symlink(target: const u8[:], newpath: const u8[:])
all   i64 readlink(path: const u8[:], out: u8[>..]&)
all   i64 link(existing: const u8[:], newpath: const u8[:])
all   i64 truncate(path: const u8[:], size: i64)
all   i64 utimes(path: const u8[:], atime_ns: i64, mtime_ns: i64)
all   i64 realpath(path: const u8[:], out: u8[>..]&)
