all   i64 processes(out: u8[>..]&)
all   i64 process_exe(pid: i64, out: u8[>..]&)
all   i64 is_elevated()

# --- Users and groups ---------------------------------------------------------
posix i64 getuid()
posix i64 geteuid()
posix i64 getgid()
posix i64 getegid()
