# sys's C functions: sys/scripts/gen_ffi.py makes sys/ffi.goose,
# src/gssys_api.h and src/gssys_stubs.c from this table.
#
#   struct Name: fields...                (every field an i64)
#   TAG ret name(param: type, ...)        TAG: all win posix linux apple bsd
#
# Results >= 0 are successes; < 0 is -errno on POSIX, -(Win32 error) on
# Windows, a failed HRESULT as itself, or GSSYS_ENOTSUP.
#
# A u8[>..]& out is appended to. Lists and records are fields, each a
# 4-byte little-endian length and its bytes; a number is an 8-byte
# little-endian field (sys.goose's Fields reads them).

struct Stat: kind mode size nlink uid gid dev ino atime_ns mtime_ns ctime_ns btime_ns attrs
struct MemInfo: total available swap_total swap_free
struct Rlimit: cur max
struct WinSize: rows cols xpixels ypixels
struct Child: pid handle stdin_fd stdout_fd stderr_fd pty

# --- Errors and the platform ------------------------------------------------
all   i32 platform_id()
all   i64 error_text(code: i64, out: u8[>..]&)
all   i32 error_is(code: i64, class: i32)
all   i64 last_error()

# --- The host -----------------------------------------------------------------
all   i64 hostname(out: u8[>..]&)
all   i64 uname(out: u8[>..]&)
all   i64 cpu_count()
all   i64 page_size()
all   i64 mem_info(out: MemInfo&)
all   i64 uptime_ms()
posix i64 load_avg(out: f64[:])
all   i64 temp_dir(out: u8[>..]&)
all   i64 home_dir(out: u8[>..]&)
all   i64 os_info(out: u8[>..]&)
all   i64 boot_time()

# --- This process -------------------------------------------------------------
all   i64 getpid()
