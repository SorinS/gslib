all   i64 rmdir(path: const u8[:])
all   i64 unlink(path: const u8[:])
all   i64 rename(from: const u8[:], to: const u8[:])
all   i64 read_dir(path: const u8[:], out: u8[>..]&)

# --- Files by descriptor (a Windows HANDLE on Windows) --------------------------
all   i64 open(path: const u8[:], flags: i64, mode: i64)
all   i64 close(fd: i64)
all   i64 read(fd: i64, buf: u8[:])
all   i64 write(fd: i64, data: const u8[:])
all   i64 pread(fd: i64, buf: u8[:], offset: i64)
all   i64 pwrite(fd: i64, data: const u8[:], offset: i64)
all   i64 seek(fd: i64, offset: i64, whence: i32)
all   i64 fsync(fd: i64)
all   i64 ftruncate(fd: i64, size: i64)
all   i64 fstat(fd: i64, out: Stat&)
all   i64 lock(fd: i64, how: i32)
all   i64 pipe(fds: i64[:])
all   i64 std_fd(n: i32)
all   i64 isatty(fd: i64)
all   i64 is_private(fd: i64)
all   i64 available(fd: i64)
posix i64 set_nonblock(fd: i64, on: i32)
posix i64 poll(fds: i64[:], events: i64[:], timeout_ms: i64)

# --- Child processes (process.goose) ------------------------------------------
all   i64 spawn(path: const u8[:], args: const u8[:], env: const u8[:], dir: const u8[:], flags: i64, stdio: i64[:], size: i64[:], out: Child&)
all   i64 child_wait(c: Child&, timeout_ms: i64, status: i64[:])
all   i64 child_kill(c: Child&, sig: i32)
all   i64 child_release(c: Child&)
all   i64 pty_resize(c: Child&, cols: i64, rows: i64)
all   i64 pty_close(c: Child&)
posix i64 fork()
posix i64 exit_now(code: i32)
posix i64 reap()

# --- The Windows registry (registry.goose) --------------------------------------
win   i64 reg_open(root: i64, path: const u8[:], access: i64)
win   i64 reg_create(root: i64, path: const u8[:], access: i64, existed: i64[:])
win   i64 reg_close(key: i64)
win   i64 reg_delete_key(root: i64, path: const u8[:], access: i64)
win   i64 reg_delete_tree(root: i64, path: const u8[:])
win   i64 reg_value_type(key: i64, name: const u8[:], size: i64[:])
win   i64 reg_get_string(key: i64, name: const u8[:], out: u8[>..]&)
win   i64 reg_get_strings(key: i64, name: const u8[:], out: u8[>..]&)
win   i64 reg_get_int(key: i64, name: const u8[:], out: i64[:])
win   i64 reg_get_binary(key: i64, name: const u8[:], out: u8[>..]&)
win   i64 reg_set_string(key: i64, name: const u8[:], value: const u8[:], vtype: i32)
win   i64 reg_set_strings(key: i64, name: const u8[:], values: const u8[:])
win   i64 reg_set_int(key: i64, name: const u8[:], value: i64, vtype: i32)
win   i64 reg_set_binary(key: i64, name: const u8[:], value: const u8[:])
win   i64 reg_delete_value(key: i64, name: const u8[:])
win   i64 reg_subkeys(key: i64, out: u8[>..]&)
win   i64 reg_value_names(key: i64, out: u8[>..]&)
win   i64 reg_info(key: i64, out: i64[:])
all   i64 expand_env(s: const u8[:], out: u8[>..]&)

