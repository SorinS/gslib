; A zone with every directive and abbreviation the parser knows.
$ORIGIN example.org.
$TTL 1h
@       IN  SOA ns1 hostmaster (
                2024010101 ; serial
                7200       ; refresh
                3600       ; retry
                1209600    ; expire
                300 )      ; minimum
        IN  NS  ns1
        IN  NS  ns2.example.net.
        MX  10 mail
        300 TXT "v=spf1 mx -all"
ns1     A   192.0.2.1
        AAAA 2001:db8::1
mail    IN 600 A 192.0.2.2
www     CNAME @
*.wild  A 192.0.2.3
sub     NS ns.sub
ns.sub  A 192.0.2.4
$TTL 86400
long    TXT ( "one"
              "two" )
$ORIGIN sub2.example.org.
a       A 192.0.2.10
b.example.org. A 192.0.2.11
$INCLUDE inc.zone
c       A 192.0.2.12
$INCLUDE inc.zone other.example.
d       A 192.0.2.13
$ORIGIN example.org.
$GENERATE 1-4 host-$ A 10.0.0.$
$GENERATE 0-6/3 $.rev PTR host-${10,3,d}.example.org.
$GENERATE 10-11 x${0,4,x} TXT "n${1,2,o}"
escaped\.dot  A 192.0.2.20
"quoted"      A 192.0.2.21
