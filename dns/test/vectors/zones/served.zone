; The zone goose-dnsd serves to the client tests (test/client.goose) and to
; dig (scripts/interop.py).
$ORIGIN example.org.
$TTL 3600
@         SOA   ns1 hostmaster 2024010101 7200 3600 1209600 300
          NS    ns1
          NS    ns2.example.net.
          MX    10 mail
          TXT   "v=spf1 mx -all"
          RRSIG SOA 13 2 3600 20500101000000 20240101000000 12345 example.org. AAECAwQFBgcICQ==
ns1       A     192.0.2.1
mail      A     192.0.2.2
          AAAA  2001:db8::2
www       CNAME web
web       CNAME host.example.net.
alias     CNAME www
*.wild    TXT   "wildcard"
a.b.c     A     192.0.2.3
sub       NS    ns.sub
ns.sub    A     192.0.2.4
_sip._udp SRV   10 5 5060 mail
big       TXT   "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
          TXT   "1123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
          TXT   "2123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
          TXT   "3123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
          TXT   "4123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
          TXT   "5123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
$GENERATE 1-2500 host-$ A 198.51.100.7
$GENERATE 1-2500 host-$ TXT "a record to make the zone transfer take more than one message"
