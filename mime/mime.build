// mime's sidecar.
//
// rand.goose's extern "c" block opens the C library for getentropy(3)
// (multipart's random boundaries); "c" is libc.dylib on macOS as it
// stands, and Linux's libc.so is a linker script, so the library itself
// is named.
dylibs_linux = ["c=libc.so.6"];

// multipart's file names follow the platform's path rules, as Go's
// filepath.Base does: a header-only constant, no C to compile.
c_headers_linux = ["src/path_unix.h"];
c_headers_macos = ["src/path_unix.h"];
c_headers_windows = ["src/path_windows.h"];

// Programs, not the package's modules.
exclude = ["test", "tools", "scripts"];
