; example.com: the zone the dns examples read and serve.
$ORIGIN example.com.
$TTL 3600
@       IN  SOA ns1 hostmaster (
                2026010101 ; serial
                7200       ; refresh
                3600       ; retry
                1209600    ; expire
                300 )      ; minimum
        IN  NS  ns1
        IN  NS  ns2
        IN  MX  10 mail
        IN  TXT "v=spf1 mx -all"
ns1     IN  A   192.0.2.1
ns2     IN  A   192.0.2.2
mail    IN  A   192.0.2.25
        IN  AAAA 2001:db8::25
www 300 IN  A   192.0.2.80
        300 IN A 192.0.2.81
ftp     IN  CNAME www
*.dev   IN  A   192.0.2.99
$GENERATE 1-4 host$ A 198.51.100.$
