// gslib's sidecar. Its C is net's TCP sockets (net/src/net.c), which
// http.client, dns and krb5 use, mime's platform constant
// (mime/src/path.c), krb5's UDP, private files
// and host names (krb5/src/krb5sys.c), pkcs11's module loading
// (pkcs11/src/p11.c), and dns's UDP and listening sockets
// (dns/src/dnsnet.c), tpm2's TPM device (tpm2/src/tpmdev.c), and service's
// service managers (service/src/service.c), built only into programs that call them.
// crypto/bignum's entropy module opens libc through an extern "c" block;
// on Linux libc.so is a linker script, so the library itself is named.
c_sources = ["net/src/net.c", "mime/src/path.c", "krb5/src/krb5sys.c", "pkcs11/src/p11.c", "dns/src/dnsnet.c", "tpm2/src/tpmdev.c", "service/src/service.c",
             "sys/src/posix.c", "sys/src/unix.c", "sys/src/win.c", "sys/src/winreg.c", "sys/src/winmgmt.c", "sys/src/gssys_stubs.c", "sspi/src/sspi.c"];
// pkcs11/src/p11.c loads PKCS#11 modules: dlopen, in libdl before glibc 2.34.
c_libs_linux = ["dl"];
// service/src/service.c: the service control manager and the event log;
// sys/src: accounts, groups and shares (netapi32), sessions (wtsapi32);
// sspi/src/sspi.c loads secur32 and crypt32 itself.
c_libs_windows = ["ws2_32", "advapi32", "netapi32", "wtsapi32"];
dylibs_linux = ["c=libc.so.6"];

// The examples, the fuzz targets, and programs of each library (tests, tools), not the package's own
// modules: the JIT's symbol table does not look for externs there.
exclude = [
    "examples",
    "fuzz",
    "crypto/bignum/test", "crypto/bignum/tools",
    "encoding/asn1/test",
    "crypto/x509/test", "crypto/x509/tools",
    "crypto/openpgp/test", "crypto/openpgp/tools",
    "crypto/tls/test", "crypto/tls/tools",
    "crypto/ssh/test", "crypto/ssh/tools",
    "net/ldap/test", "net/ldap/tools",
    "encoding/yaml/test",
    "encoding/xml/test", "encoding/xml/tools",
    "encoding/cbor/test", "encoding/cbor/tools",
    "net/http/test", "net/http/tools",
    "compress/test", "compress/tools",
    "mime/test", "mime/tools",
    "krb5/test", "krb5/tools",
    "jwx/test", "jwx/tools",
    "pkcs11/test", "pkcs11/tools",
    "dns/test", "dns/tools",
    "mail/test", "mail/tools",
    "acme/test", "acme/tools",
    "oauth/test", "oauth/tools",
    "tsp/test", "tsp/tools",
    "est/test", "est/tools",
    "scep/test", "scep/tools",
    "ntlm/test", "ntlm/tools",
    "saml/test", "saml/tools",
    "webauthn/test", "webauthn/tools",
    "tpm2/test", "tpm2/tools", "tpm2/scripts",
    "sys/test", "sys/scripts",
    "sspi/test", "sspi/scripts",
];
