// gslib's sidecar. Its C is entropy's random bytes (entropy/src/entropy.c),
// which bignum and every library that makes keys or nonces use, net's
// sockets (net/src/net.c: TCP, UDP, listening, Unix-domain, the resolver),
// which http, ldap, dns, krb5 and the tools use, pkcs11's module loading
// (pkcs11/src/p11.c), service's service managers (service/src/service.c),
// sys's operating system calls (sys/src: files, processes and terminals,
// which mime and tpm2 use too) and sspi's SSPI, built only into programs
// that call them.
c_sources = ["entropy/src/entropy.c", "net/src/net.c", "pkcs11/src/p11.c", "service/src/service.c",
             "sys/src/posix.c", "sys/src/unix.c", "sys/src/win.c", "sys/src/winreg.c", "sys/src/winmgmt.c", "sys/src/spawn.c", "sys/src/winspawn.c", "sys/src/gssys_stubs.c", "sspi/src/sspi.c"];
// pkcs11/src/p11.c loads PKCS#11 modules: dlopen, in libdl before glibc 2.34.
c_libs_linux = ["dl"];
// service/src/service.c: the service control manager and the event log;
// sys/src: accounts, groups and shares (netapi32), sessions (wtsapi32);
// sspi/src/sspi.c loads secur32 and crypt32 itself; entropy/src/entropy.c:
// BCryptGenRandom.
c_libs_windows = ["ws2_32", "advapi32", "netapi32", "wtsapi32", "bcrypt"];

// The examples, the fuzz targets, and programs of each library (tests, tools), not the package's own
// modules: the JIT's symbol table does not look for externs there.
exclude = [
    "examples",
    "fuzz",
    "crypto/bignum/test", "crypto/bignum/tools",
    "encoding/asn1/test",
    "crypto/x509/test", "crypto/x509/tools",
    "crypto/openpgp/test", "crypto/openpgp/tools",
    "crypto/tls/test", "crypto/tls/tools",
    "crypto/ssh/test", "crypto/ssh/tools",
    "net/ldap/test", "net/ldap/tools",
    "encoding/yaml/test",
    "encoding/xml/test", "encoding/xml/tools",
    "encoding/cbor/test", "encoding/cbor/tools",
    "net/http/test", "net/http/tools",
    "compress/test", "compress/tools",
    "mime/test", "mime/tools",
    "krb5/test", "krb5/tools",
    "jwx/test", "jwx/tools",
    "pkcs11/test", "pkcs11/tools",
    "dns/test", "dns/tools",
    "mail/test", "mail/tools",
    "acme/test", "acme/tools",
    "oauth/test", "oauth/tools",
    "tsp/test", "tsp/tools",
    "est/test", "est/tools",
    "scep/test", "scep/tools",
    "ntlm/test", "ntlm/tools",
    "radius/test", "radius/tools",
    "smb/test", "smb/tools", "smb/scripts",
    "saml/test", "saml/tools",
    "webauthn/test", "webauthn/tools",
    "tpm2/test", "tpm2/tools", "tpm2/scripts",
    "entropy/test", "entropy/scripts",
    "sys/test", "sys/scripts",
    "sspi/test", "sspi/scripts",
];
