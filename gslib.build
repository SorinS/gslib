// gslib's sidecar. Its C is http.client's sockets (net/http/src/httpnet.c)
// and mime's platform constant (mime/src/path.c), built only into programs
// that call them. crypto/bignum's entropy module opens libc
// through an extern "c" block; on Linux libc.so is a linker script, so the
// library itself is named.
c_sources = ["net/http/src/httpnet.c", "mime/src/path.c"];
c_libs_windows = ["ws2_32"];
dylibs_linux = ["c=libc.so.6"];

// Programs of each library (tests, tools, examples), not the package's own
// modules: the JIT's symbol table does not look for externs there.
exclude = [
    "crypto/bignum/examples", "crypto/bignum/test", "crypto/bignum/tools",
    "encoding/asn1/test",
    "crypto/x509/test", "crypto/x509/tools",
    "crypto/tls/test", "crypto/tls/tools",
    "crypto/ssh/test", "crypto/ssh/tools",
    "net/ldap/test", "net/ldap/tools",
    "encoding/yaml/test",
    "net/http/test", "net/http/tools",
    "compress/test", "compress/tools", "compress/examples",
    "mime/test", "mime/tools",
];
