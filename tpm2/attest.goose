// tpm2.attest: attestation. On the TPM: Quote, Certify, CertifyCreation,
// MakeCredential and ActivateCredential. In software, with no TPM: a
// TPMS_ATTEST read and checked (its signature by the attestation key, the
// nonce in extraData, a quote's PCR selection and digest against PCR
// values given), a TCG crypto-agile event log (TCG_PCR_EVENT2, the TCG PC
// Client Platform Firmware Profile §10) replayed to the PCR values it
// should give, and MakeCredential (Part 1 §24, Part 3 §12.6): a
// credential for an attestation key's Name that only the TPM holding the
// EK can recover, which is how a verifier learns that the AK is on that
// TPM.
//
//   let q, e = tpm2::quote(t, ak, s, nonce, tpm2::ALG_NULL, tpm2::ALG_SHA256, sel);
//   // on the verifier, with the AK's public area and the PCR values:
//   let a, ev = tpm2::verify_quote(ak_pub, q.attest, q.sig, nonce, sel, values);

namespace tpm2;

import std;
import tpm2;
import tpm2.transport;
import tpm2.session;
import tpm2.commands;
import tpm2.policy;
import crypto.bignum;
import crypto.bignum.aes;
import crypto.bignum.modes;

// --- TPMS_ATTEST ------------------------------------------------------------------------

// A TPMS_ATTEST: what a Quote, Certify or CertifyCreation signed.
// kind is its tag (ST_ATTEST_QUOTE, ...). For a quote, sel and
// pcr_digest; for Certify, the certified object's name and qualified
// name; for CertifyCreation, its name and creation_hash.
struct Attest {
    magic:         u32         = 0,
    kind:          u16         = 0,
    signer:        u8[..66]    = [],  // qualifiedSigner
    extra:         u8[..64]    = [],  // extraData: the caller's nonce
    clock:         u64         = 0, reset_count: u32 = 0, restart_count: u32 = 0, safe: bool = false,
    firmware:      u64         = 0,
    sel:           PcrSel[..4] = [],
    pcr_digest:    u8[..64]    = [],
    name:          u8[..66]    = [],
    qname:         u8[..66]    = [],
    creation_hash: u8[..64]    = [],
}

// A TPMS_ATTEST from its bytes: a quote, certify or creation attestation,
// generated by a TPM (magic), every byte accounted for.
fn parse_attest(b: const u8[:]) -> Attest, i64 {
    var a = Attest { .. };
    var r = reader(b);
    a.magic = get_u32(r);
    a.kind = get_u16(r);
    read_into(r, a.signer);
    read_into(r, a.extra);
    a.clock = get_u64(r);
    a.reset_count = get_u32(r);
    a.restart_count = get_u32(r);
    let safe = get_u8(r);
    a.safe = safe == 1;
    a.firmware = get_u64(r);
    if !r.ok || safe > 1 { return a, ERR_MALFORMED; }
    if a.magic != GENERATED_VALUE { return a, ERR_MALFORMED; }
    if a.kind == ST_ATTEST_QUOTE {
        a.sel = read_pcr_selection(r);
        read_into(r, a.pcr_digest);
    } else if a.kind == ST_ATTEST_CERTIFY {
        read_into(r, a.name);
        read_into(r, a.qname);
    } else if a.kind == ST_ATTEST_CREATION {
        read_into(r, a.name);
        read_into(r, a.creation_hash);
    } else {
        return a, ERR_UNSUPPORTED;
    }
    if !r.ok || left(r) != 0 { return a, ERR_MALFORMED; }
    return a, OK;
}

// Whether a public area is an attestation key: a restricted signing key
// that never leaves its TPM (fixedTPM) and was made there.
fn is_attestation_key(p: Public) -> bool {
    let need = OBJ_RESTRICTED | OBJ_SIGN | OBJ_FIXED_TPM | OBJ_SENSITIVE_DATA_ORIGIN;
    return (p.attrs & need) == need && (p.attrs & OBJ_DECRYPT) == 0;
}

// The common checks: the signature by signer over the attestation's bytes
// (hashed by the signature's hash), then its contents parsed, of kind, with
// extraData the nonce. The signature is checked first, so nothing unsigned
// is believed.
fn verify_attest(signer: Public, attest: const u8[:], sig: Signature, nonce: const u8[:], kind: u16) -> Attest, i64 {
    if hash_id(sig.hash) == 0 { return Attest { .. }, ERR_UNSUPPORTED; }
    let digest = hash(sig.hash, attest);
    let ev = verify_signature(signer, digest, sig);
    if ev != OK { return Attest { .. }, ev; }
    let a, ep = parse_attest(attest);
    if ep != OK { return a, ep; }
    if a.kind != kind { return a, ERR_TYPE; }
    if a.extra != nonce { return a, ERR_NONCE; }
    return a, OK;
}

// A quote checked: signed by the attestation key ak (restricted signing,
// ERR_ARG otherwise), extraData the nonce, the PCR selection the one given,
// and the PCR digest that of the values given (each bank's selected PCRs in
// order, as pcr_read gives them), hashed by the signature's hash.
fn verify_quote(ak: Public, attest: const u8[:], sig: Signature, nonce: const u8[:], sel: const PcrSel[:],
                values: const u8[..64][:]) -> Attest, i64 {
    if !is_attestation_key(ak) { return Attest { .. }, ERR_ARG; }
    let a, e = verify_attest(ak, attest, sig, nonce, ST_ATTEST_QUOTE);
    if e != OK { return a, e; }
    if a.sel.len != sel.len { return a, ERR_PCR; }
    var n = 0;
    for i in sel.len {
        if a.sel[i].hash != sel[i].hash || a.sel[i].mask != sel[i].mask { return a, ERR_PCR; }
        n += pcr_list(sel[i].mask).len;
    }
    if n != values.len { return a, ERR_PCR; }
    if pcr_digest(sig.hash, values) != a.pcr_digest { return a, ERR_PCR; }
    return a, OK;
}

// A Certify checked: signed by signer, extraData the nonce, and the
// certified object's Name that of the public area given.
fn verify_certify(signer: Public, attest: const u8[:], sig: Signature, nonce: const u8[:], object: Public) -> Attest, i64 {
    let a, e = verify_attest(signer, attest, sig, nonce, ST_ATTEST_CERTIFY);
    if e != OK { return a, e; }
    if a.name != public_name(object) { return a, ERR_NAME; }
    return a, OK;
}

// A CertifyCreation checked: signed by signer, extraData the nonce, the
// object's Name that of the public area given, and its creation hash the
// one Create returned (the hash of its creation data).
fn verify_creation(signer: Public, attest: const u8[:], sig: Signature, nonce: const u8[:], object: Public,
                   creation_hash: const u8[:]) -> Attest, i64 {
    let a, e = verify_attest(signer, attest, sig, nonce, ST_ATTEST_CREATION);
    if e != OK { return a, e; }
    if a.name != public_name(object) { return a, ERR_NAME; }
    if a.creation_hash != creation_hash { return a, ERR_INTEGRITY; }
    return a, OK;
}

// --- On the TPM -------------------------------------------------------------------------------

// What Quote, Certify and CertifyCreation return: the TPMS_ATTEST's bytes
// and the signature over them.
struct Attested { attest: u8[..1024] = [], sig: Signature = Signature { .. } }

fn read_attested(rp: const u8[:]) -> Attested, i64 {
    var q = Attested { .. };
    var r = reader(rp);
    read_into(r, q.attest);
    q.sig = read_signature(r);
    if !r.ok || left(r) != 0 { return q, ERR_MALFORMED; }
    return q, OK;
}

// TPM2_Quote of the selected PCRs by a signing key, with the nonce as
// qualifyingData; scheme ALG_NULL uses the key's own.
fn quote(t: Tpm&, key: Entity, s: Session&, nonce: const u8[:], scheme: u16, h: u16, sel: const PcrSel[:]) -> Attested, i64 {
    var p: u8[>..] = [];
    put_2b(p, nonce);
    put_sig_scheme(p, scheme, h);
    put_pcr_selection(p, sel);
    var none = no_session();
    let hs = [key];
    let rp, hh, e = execute(t, Cmd { cc: CC_Quote, nauth: 1, enc_in: true, enc_out: true }, hs, s, none, p);
    if e != OK { return Attested { .. }, e; }
    return read_attested(rp);
}

// TPM2_Certify: key signs that object is loaded on this TPM. Both need
// authorization: object (the ADMIN role) by s_obj, key by s_key.
fn certify(t: Tpm&, object: Entity, key: Entity, s_obj: Session&, s_key: Session&, nonce: const u8[:], scheme: u16,
           h: u16) -> Attested, i64 {
    var p: u8[>..] = [];
    put_2b(p, nonce);
    put_sig_scheme(p, scheme, h);
    let hs = [object, key];
    let rp, hh, e = execute(t, Cmd { cc: CC_Certify, nauth: 2, enc_in: true, enc_out: true }, hs, s_obj, s_key, p);
    if e != OK { return Attested { .. }, e; }
    return read_attested(rp);
}

// TPM2_CertifyCreation: key signs that object was created by this TPM with
// the creation hash and ticket Create gave.
fn certify_creation(t: Tpm&, key: Entity, object: Entity, s: Session&, nonce: const u8[:], creation_hash: const u8[:],
                    scheme: u16, h: u16, ticket: Ticket) -> Attested, i64 {
    var p: u8[>..] = [];
    put_2b(p, nonce);
    put_2b(p, creation_hash);
    put_sig_scheme(p, scheme, h);
    put_ticket(p, ticket);
    var none = no_session();
    let hs = [key, object];
    let rp, hh, e = execute(t, Cmd { cc: CC_CertifyCreation, nauth: 1, enc_in: true, enc_out: true }, hs, s, none, p);
    if e != OK { return Attested { .. }, e; }
    return read_attested(rp);
}

// --- Credentials ---------------------------------------------------------------------------------

// A credential for ActivateCredential: the TPM2B_ID_OBJECT's contents
// (integrityHMAC and encIdentity) and the TPM2B_ENCRYPTED_SECRET's (the
// seed encrypted to the EK).
struct Credential { blob: u8[..256] = [], secret: u8[..1024] = [] }

// MakeCredential in software (Part 1 §24.4, Part 3 §12.6): the credential
// (at most the EK nameAlg's digest size) protected for the EK's TPM and
// bound to the AK's Name. The seed is encrypted to the EK by RSA-OAEP
// ("IDENTITY") or an ephemeral ECDH and KDFe; symKey = KDFa(nameAlg, seed,
// "STORAGE", name, "", EK's AES key bits); encIdentity = AES-CFB(symKey,
// IV 0, TPM2B_DIGEST(credential)); HMACkey = KDFa(nameAlg, seed,
// "INTEGRITY", "", "", digest bits); integrity = HMAC(HMACkey, encIdentity
// || name). eph and rnd fix the randomness, for known-answer tests.
fn make_credential(ek: Public, ak_name: const u8[:], credential: const u8[:], eph: const u8[:] = "",
                   rnd: const u8[:] = "") -> Credential, i64 {
    var c = Credential { .. };
    let hl = digest_size(ek.name_alg);
    if hl == 0 { return c, ERR_UNSUPPORTED; }
    if credential.len == 0 || credential.len > hl || ak_name.len == 0 { return c, ERR_ARG; }
    if ek.sym_alg != ALG_AES || ek.sym_mode != ALG_CFB || (ek.sym_bits != 128 && ek.sym_bits != 192 && ek.sym_bits != 256) {
        return c, ERR_UNSUPPORTED;
    }
    let seed, enc, e = secret_to(ek, "IDENTITY", eph, rnd);
    if e != OK { return c, e; }
    let bits = ek.sym_bits as i64;
    let sym = kdfa(ek.name_alg, seed, "STORAGE", ak_name, "", bits);
    var cv: u8[>..] = [];
    put_2b(cv, credential);
    let aes = bignum::aes_init(sym);
    let iv = zeros(16);
    bignum::cfb_encrypt(aes, iv, cv);
    let hkey = kdfa(ek.name_alg, seed, "INTEGRITY", "", "", 8 * hl);
    var m: u8[>..] = [];
    m.append(cv);
    m.append(ak_name);
    let mac = hmac(ek.name_alg, hkey, m);
    var blob: u8[>..] = [];
    put_2b(blob, mac);
    blob.append(cv);
    if !set_bytes(c.blob, blob) || !set_bytes(c.secret, enc) { return c, ERR_UNSUPPORTED; }
    return c, OK;
}

// TPM2_MakeCredential on the TPM, with a loaded public key (the EK's,
// loaded by LoadExternal on another TPM, say).
fn make_credential_tpm(t: Tpm&, key: Entity, ak_name: const u8[:], credential: const u8[:]) -> Credential, i64 {
    var c = Credential { .. };
    var p: u8[>..] = [];
    put_2b(p, credential);
    put_2b(p, ak_name);
    let hs = [key];
    let rp, h, e = execute0(t, CC_MakeCredential, hs, p);
    if e != OK { return c, e; }
    var r = reader(rp);
    read_into(r, c.blob);
    read_into(r, c.secret);
    if !r.ok || left(r) != 0 { return c, ERR_MALFORMED; }
    return c, OK;
}

// TPM2_ActivateCredential: the TPM recovers the credential when the EK is
// its own and the AK (activate) is the object the credential was made for.
// The AK is authorized by s_ak (ADMIN role: its authValue), the EK by s_ek
// (the TCG EK's policy: ek_policy_session).
fn activate_credential(t: Tpm&, ak: Entity, ek: Entity, s_ak: Session&, s_ek: Session&, c: const Credential&) -> u8[..64], i64 {
    var out: u8[..64] = [];
    var p:   u8[>..]  = [];
    put_2b(p, c.blob);
    put_2b(p, c.secret);
    let hs = [ak, ek];
    let rp, h, e = execute(t, Cmd { cc: CC_ActivateCredential, nauth: 2, enc_in: true, enc_out: true }, hs, s_ak, s_ek, p);
    if e != OK { return out, e; }
    var r = reader(rp);
    read_into(r, out);
    if !r.ok || left(r) != 0 { return out, ERR_MALFORMED; }
    return out, OK;
}

// --- Event logs ------------------------------------------------------------------------------------

let EV_NO_ACTION: u32 = 0x00000003;
let EV_SEPARATOR: u32 = 0x00000004;

fn le16(b: const u8[:], at: i64) -> u16 { b[at] | ((b[at + 1] as u16) << 8) }
fn le32(b: const u8[:], at: i64) -> u32 {
    b[at] | ((b[at + 1] as u32) << 8) | ((b[at + 2] as u32) << 16) | ((b[at + 3] as u32) << 24)
}

// What replaying a log gives: the 24 PCRs of one bank, and the number of
// events extended.
struct Replayed { pcrs: u8[..64][24] = [[]; 24], events: i64 = 0 }

// Replays a crypto-agile TCG event log (a TCG_PCR_EVENT holding the "Spec
// ID Event03" header with the digest sizes, then TCG_PCR_EVENT2s) for the
// bank alg: each event but EV_NO_ACTION extends its PCR by its digest of
// alg. PCRs start at zero, PCR 0 at its locality when a StartupLocality
// event says so. ERR_EVENTLOG for a log that is not crypto-agile, is
// truncated, names a PCR above 23 or a hash the header did not list, has
// an event without a digest of alg, or has a StartupLocality event after
// PCR 0's first extend or a second one (which would let events put before
// it be replaced by anything).
fn replay_event_log(log: const u8[:], alg: u16) -> Replayed, i64 {
    var out = Replayed { .. };
    let hl = digest_size(alg);
    if hl == 0 { return out, ERR_UNSUPPORTED; }
    for i in 24 { out.pcrs[i].append(zeros(hl)); }
    // TCG_PCR_EVENT: pcrIndex, eventType, SHA-1 digest, eventSize, event.
    if log.len < 32 { return out, ERR_EVENTLOG; }
    if le32(log, 0) != 0 || le32(log, 4) != EV_NO_ACTION { return out, ERR_EVENTLOG; }
    let size0 = le32(log, 28) as i64;
    if size0 > log.len - 32 || size0 < 29 { return out, ERR_EVENTLOG; }
    let spec = log[32..32 + size0];
    if spec[..16] != "Spec ID Event03\x00" { return out, ERR_EVENTLOG; }
    let nalg = le32(spec, 24) as i64;
    if nalg < 1 || nalg > 16 || 28 + 4 * nalg + 1 > spec.len { return out, ERR_EVENTLOG; }
    var algs:  u16[..16] = [];
    var sizes: i64[..16] = [];
    for i in nalg {
        algs.push(le16(spec, 28 + 4 * i));
        sizes.push(le16(spec, 30 + 4 * i));
    }
    let vendor = spec[28 + 4 * nalg] as i64;
    if 28 + 4 * nalg + 1 + vendor != spec.len { return out, ERR_EVENTLOG; }
    var at = 32 + size0;
    var pcr0_set = false;   // PCR 0 extended, or its locality set
    while at < log.len {
        if log.len - at < 12 { return out, ERR_EVENTLOG; }
        let pcr = le32(log, at) as i64;
        let etype = le32(log, at + 4);
        let count = le32(log, at + 8) as i64;
        at += 12;
        if pcr > 23 || count > 16 { return out, ERR_EVENTLOG; }
        var digest: u8[..64] = [];
        var found = false;
        for i in count {
            if log.len - at < 2 { return out, ERR_EVENTLOG; }
            let a = le16(log, at);
            at += 2;
            var size = -1;
            for j in algs.len { if algs[j] == a { size = sizes[j]; } }
            if size < 0 || log.len - at < size { return out, ERR_EVENTLOG; }
            if a == alg {
                if size != hl { return out, ERR_EVENTLOG; }
                digest.clear();
                digest.append(log[at..at + size]);
                found = true;
            }
            at += size;
        }
        if log.len - at < 4 { return out, ERR_EVENTLOG; }
        let esize = le32(log, at) as i64;
        at += 4;
        if esize > log.len - at { return out, ERR_EVENTLOG; }
        let event = log[at..at + esize];
        at += esize;
        if etype == EV_NO_ACTION {
            if pcr == 0 && esize == 17 && event[..16] == "StartupLocality\x00" {
                if pcr0_set { return out, ERR_EVENTLOG; }
                pcr0_set = true;
                out.pcrs[0].clear();
                out.pcrs[0].append(zeros(hl - 1));
                out.pcrs[0].push(event[16]);
            }
            continue;
        }
        if !found { return out, ERR_EVENTLOG; }
        if pcr == 0 { pcr0_set = true; }
        let v = extend_value(alg, out.pcrs[pcr], digest);
        out.pcrs[pcr].clear();
        out.pcrs[pcr].append(v);
        out.events++;
    }
    return out, OK;
}

// An event log checked against PCR values (from a verified quote): the
// replayed bank alg must give each PCR of mask the value given, in order.
fn check_event_log(log: const u8[:], alg: u16, mask: u32, values: const u8[..64][:]) -> i64 {
    let rp, e = replay_event_log(log, alg);
    if e != OK { return e; }
    let idx = pcr_list(mask);
    if idx.len != values.len { return ERR_ARG; }
    for i in idx.len {
        if rp.pcrs[idx[i]] != values[i] { return ERR_PCR; }
    }
    return OK;
}
